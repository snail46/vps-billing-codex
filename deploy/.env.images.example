APP_ENV=production
APP_PORT=9090
ADMIN_PORT=9092
VPS_BILLING_IMAGE_TAG=v1

POSTGRES_DB=vps_billing
POSTGRES_USER=vps_billing
POSTGRES_PASSWORD=replace-with-a-strong-database-password

USER_WEB_ORIGIN=http://localhost:9090
ADMIN_WEB_ORIGIN=http://localhost:9092
# Set email and password together for the first start; leave both blank to skip.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
USER_SESSION_SECRET=replace-with-an-independent-32-character-user-session-secret
ADMIN_SESSION_SECRET=replace-with-an-independent-32-character-admin-session-secret
USER_CSRF_SECRET=replace-with-an-independent-32-character-user-csrf-secret
ADMIN_CSRF_SECRET=replace-with-an-independent-32-character-admin-csrf-secret
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-an-independent-32-character-totp-encryption-key
FAKE_PAYMENT_WEBHOOK_SECRET=replace-with-an-independent-32-character-payment-webhook-secret
METRICS_TOKEN=replace-with-an-independent-32-character-metrics-token

FAKE_PAYMENT_ENABLED=false
ALLOW_INSECURE_HTTP=true
COOKIE_SECURE=false
SUBSCRIPTION_GRACE_PERIOD=72h
LOG_LEVEL=info

# Only required with: docker compose --profile runman ...
RUNMAN_PORT=9091
RUNMAN_TLS_DIRECTORY=./runman-tls
