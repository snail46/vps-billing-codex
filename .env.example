APP_ENV=development
APP_BASE_URL=http://localhost:8080
SERVER_ADDRESS=:8080
USER_WEB_ORIGIN=http://localhost:3000
ADMIN_WEB_ORIGIN=http://localhost:3001

POSTGRES_DB=vps_billing
POSTGRES_USER=vps_billing
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://vps_billing:change-me@postgres:5432/vps_billing?sslmode=disable

REDIS_URL=redis://redis:6379/0

USER_SESSION_SECRET=change-me-user-session-at-least-32-characters
ADMIN_SESSION_SECRET=change-me-admin-session-at-least-32-characters
USER_CSRF_SECRET=change-me-user-csrf-at-least-32-characters
ADMIN_CSRF_SECRET=change-me-admin-csrf-at-least-32-characters
ADMIN_TOTP_ENCRYPTION_KEY=change-me-admin-totp-key-at-least-32-characters
FAKE_PAYMENT_WEBHOOK_SECRET=change-me-fake-payment-secret-at-least-32-characters
METRICS_TOKEN=change-me-metrics-token-at-least-32-characters
FAKE_PAYMENT_ENABLED=true
SUBSCRIPTION_GRACE_PERIOD=72h
COOKIE_SECURE=false
LOG_LEVEL=info
