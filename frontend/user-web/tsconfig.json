{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "useDefineForClassFields": true
  },
  "include": ["src", "vite.config.ts"],
  "references": [
    { "path": "../packages/api-types" },
    { "path": "../packages/i18n" },
    { "path": "../packages/ui" }
  ]
}
