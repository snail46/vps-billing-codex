{
  "name": "vps-billing-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend/user-web",
    "frontend/admin-web",
    "frontend/packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint frontend --max-warnings=0",
